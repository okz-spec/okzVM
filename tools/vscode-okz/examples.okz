-- okzCODE Examples for VS Code
-- This file demonstrates various language features
-- for testing the syntax highlighter

-- 1. Variables & Types
local name = "okzVM"
local count = 42
local ratio = 3.14
local is_ready = true
local nothing = nil
local table_example = { key = "value"; num = 123 }
local array_example = [1, 2, 3, 4, 5]

-- 2. Functions
function greet(name)
  return "Hello, " .. name .. "!"
end

local function add(a, b)
  return a + b
end

-- Multiple returns
function divmod(n, d)
  return n / d, n % d
end

-- Varargs
function sum(first, ...)
  local args = ...
  local total = first
  local i = 1
  while i <= #args do
    total = total + args[i]
    i = i + 1
  end
  return total
end

-- 3. Control Flow
if count > 10 then
  print("Large number")
elseif count > 5 then
  print("Medium number")
else
  print("Small number")
end

for i = 1, 10 do
  count = count + i
end

while count > 0 do
  count = count - 1
end

repeat
  count = count + 1
until count >= 100

-- Generic for
local scores = { alice = 95; bob = 87; carol = 92 }
for name, score in pairs(scores) do
  print(name .. ": " .. tostring(score))
end

-- Break and continue
for i = 1, 100 do
  if i == 5 then break end
end

-- 4. Graphics
screen.clear(0, 0, 0)
screen.color(255, 0, 0)
screen.rect(10, 10, 100, 100)
screen.color(0, 255, 0)
screen.circle(200, 100, 30)
screen.color(0, 0, 255)
screen.line(0, 0, 320, 200)
screen.color(255, 255, 0)
screen.triangle(150, 10, 100, 80, 200, 80)

-- 5. Input
if keyboard.justPressed("Enter") then
  print("Enter pressed")
end

if mouse.left() then
  local mx = mouse.x()
  local my = mouse.y()
end

-- 6. File I/O
file.write("test.txt", "Hello World")
local data = file.read("test.txt")
local exists = file.exists("test.txt")
local files = file.readDir(".")

-- 7. Audio
audio.tone(440, 0.5, "square", 0.3)

-- 8. Process
local pid = process.spawn("worker.okz")
local procs = process.list()
process.kill(pid)

-- 9. 3D Rendering
local verts = { { x = -1; y = 0; z = 0 }; { x = 1; y = 0; z = 0 }; { x = 0; y = 1; z = 0 } }
local tris = { { i0 = 0; i1 = 1; i2 = 2; color = { r = 255; g = 0; b = 0 } } }
screen.render3D({
  vertices = verts; triangles = tris;
  camera = { x = 0; y = 2; z = 5; rx = -0.3; ry = 0; fov = 70 };
  scale = 0.5
})

-- 10. Math
local pi = math.pi
local sin_val = math.sin(pi / 2)
local rand = math.random(1, 100)
local v1 = math.vec3(1, 2, 3)
local v2 = math.vec3(4, 5, 6)
local dist = v1:distance(v2)

-- 11. Bitwise
local flags = bit.bor(1, 4)
local masked = bit.band(flags, 5)

-- 12. Strings
local upper = string.upper("hello")
local sub = string.sub("world", 1, 3)
local found = string.find("hello world", "world")
local s = tostring(42)
local n = tonumber("123")

-- 13. Tables
local items = {}
table.insert(items, 10)
table.insert(items, 20)
table.sort(items)
local csv = table.concat(items, ", ")
local keys = table.keys(scores)

-- 14. Debug
local trace = debug.traceback()
print(type(trace))

-- 15. Protected Call
local ok, result = pcall(function()
  return 1 / 0
end)

-- Main loop template
while true do
  -- Update
  -- Render
  screen.sync()
end