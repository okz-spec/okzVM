-- okzCODE Examples for VS Code
-- This file demonstrates various language features
-- for testing the syntax highlighter

-- 1. Variables & Types
local name = "okzVM"
local count = 42
local ratio = 3.14
local is_ready = true
local nothing = nil
local table_example = { key = "value"; num = 123 }
local array_example = [1, 2, 3, 4, 5]

-- 2. Functions
function greet(name)
  return "Hello, " .. name .. "!"
end

local function add(a, b)
  return a + b
end

-- 3. Control Flow
if count > 10 then
  print("Large number")
elseif count > 5 then
  print("Medium number")
else
  print("Small number")
end

for i = 1, 10 do
  count = count + i
end

while count > 0 do
  count = count - 1
end

repeat
  count = count + 1
until count >= 100

-- 4. Import
import gfx

-- 5. Graphics
drawRect(10, 10, 100, 100, 255, 0, 0)
drawString(20, 50, "Hello okz!", 255, 255, 255)
font.drawString(20, 70, "Bitmap Font", 0, 255, 0)

-- 6. Input
if keyboard.justPressed("Enter") then
  print("Enter pressed")
end

if mouse.left() then
  local x = mouse.x()
  local y = mouse.y()
end

-- 7. File I/O
save.write("test.txt", "Hello World")
local data = save.read("test.txt")
local files = save.list()

-- 8. Audio
audio.tone(440, 0.5, "square", 0.3)

-- 9. Process
local pid = process.spawn("worker.okz")
local procs = process.list()
process.kill(pid)

-- 10. 3D Rendering
local verts = { { x = -1; y = 0; z = 0 }; { x = 1; y = 0; z = 0 }; { x = 0; y = 1; z = 0 } }
local tris = { { i0 = 0; i1 = 1; i2 = 2; color = { r = 255; g = 0; b = 0 } } }
screen.render3D({
  vertices = verts; triangles = tris;
  camera = { x = 0; y = 2; z = 5; rx = -0.3; ry = 0; fov = 70 };
  scale = 0.5
})

-- 11. Math
local pi = math.pi
local sin_val = math.sin(pi / 2)
local rand = math.random(1, 100)

-- 12. Bitwise
local flags = bit.bor(1, 4)
local masked = bit.band(flags, 5)

-- 13. Strings
local upper = string.upper("hello")
local sub = string.sub("world", 1, 3)
local found = string.find("hello world", "world")

-- 14. Tables
local items = {}
table.insert(items, 10)
table.insert(items, 20)
table.sort(items)
local csv = table.concat(items, ", ")

-- 15. Events
event.on("myEvent", function()
  print("Event fired!")
end)
event.emit("myEvent")

-- 16. Debug
local trace = debug.traceback()
print(type(trace))

-- 17. Protected Call
local ok, result = pcall(function()
  return 1 / 0
end)

-- Main loop template
while true do
  -- Update
  -- Render
  screen.sync()
end