{
  "Function declaration": {
    "prefix": "fun",
    "body": "function ${1:name}(${2:params})\n  ${3:-- body}\nend",
    "description": "Define a function"
  },
  "Local function": {
    "prefix": "lfun",
    "body": "local function ${1:name}(${2:params})\n  ${3:-- body}\nend",
    "description": "Define a local function"
  },
  "For loop": {
    "prefix": "for",
    "body": "for ${1:i} = ${2:1}, ${3:10} do\n  ${4:-- body}\nend",
    "description": "Numeric for loop"
  },
  "While loop": {
    "prefix": "while",
    "body": "while ${1:condition} do\n  ${2:-- body}\nend",
    "description": "While loop"
  },
  "Repeat until": {
    "prefix": "repeat",
    "body": "repeat\n  ${1:-- body}\nuntil ${2:condition}",
    "description": "Repeat until loop"
  },
  "If statement": {
    "prefix": "if",
    "body": "if ${1:condition} then\n  ${2:-- body}\nend",
    "description": "If statement"
  },
  "If-else": {
    "prefix": "ife",
    "body": "if ${1:condition} then\n  ${2:-- body}\nelse\n  ${3:-- body}\nend",
    "description": "If-else statement"
  },
  "Table literal": {
    "prefix": "tbl",
    "body": "{\n  ${1:key} = ${2:value};\n}",
    "description": "Table literal"
  },
  "Local variable": {
    "prefix": "loc",
    "body": "local ${1:name} = ${2:value}",
    "description": "Local variable declaration"
  },
  "Import module": {
    "prefix": "imp",
    "body": "import ${1:module}",
    "description": "Import a module"
  },
  "Protected call": {
    "prefix": "pcall",
    "body": "local ok, err = pcall(function()\n  ${1:-- code that might fail}\nend)\nif not ok then\n  system.log(\"Error: \" .. tostring(err))\nend",
    "description": "Protected call with error handling"
  },
  "Screen Sync": {
    "prefix": "sync",
    "body": "screen.sync()",
    "description": "Sync backbuffer to display"
  },
  "Screen clear": {
    "prefix": "clear",
    "body": "screen.color(${1:r}, ${2:g}, ${3:b})\nscreen.rect(0, 0, screen.width(), screen.height())",
    "description": "Clear screen with color"
  },
  "3D Render": {
    "prefix": "render3d",
    "body": "screen.render3D({\n  vertices = ${1:verts};\n  triangles = ${2:tris};\n  camera = { x = ${3:0}; y = ${4:3}; z = ${5:6}; rx = ${6:-0.3}; ry = ${7:0}; fov = ${8:70} };\n  scale = ${9:0.5}\n})",
    "description": "Render a 3D scene"
  },
  "3D Box": {
    "prefix": "box",
    "body": "local ${1:name} = SCENE3D.box(${2:x}, ${3:z}, ${4:w}, ${5:h}, ${6:d}, ${7:r}, ${8:g}, ${9:b})",
    "description": "Create a 3D box mesh"
  },
  "3D Floor": {
    "prefix": "floor",
    "body": "local ${1:name} = SCENE3D.floor(${2:tiles}, ${3:size}, ${4:r}, ${5:g}, ${6:b})",
    "description": "Create a 3D ground mesh"
  },
  "Keyboard handler": {
    "prefix": "kbd",
    "body": "if keyboard.${1:justPressed}(\"${2:KeyW}\") then\n  ${3:-- action}\nend",
    "description": "Keyboard input handler"
  },
  "Mouse handler": {
    "prefix": "mouse",
    "body": "if mouse.${1:left}() then\n  ${2:-- action}\nend",
    "description": "Mouse input handler"
  },
  "Read file": {
    "prefix": "fread",
    "body": "local data = file.read(\"${1:path}\")",
    "description": "Read text file from project"
  },
  "Read binary file": {
    "prefix": "freadb",
    "body": "local bytes = file.readBinary(\"${1:path}\")",
    "description": "Read binary file from project"
  },
  "Write file": {
    "prefix": "fwrite",
    "body": "file.write(\"${1:path}\", ${2:data})",
    "description": "Write text file to project"
  },
  "List directory": {
    "prefix": "freaddir",
    "body": "local entries = file.readDir(\"${1:path}\")",
    "description": "List directory contents"
  },
  "Process spawn": {
    "prefix": "spawn",
    "body": "local pid = process.spawn(\"${1:app.okz}\")",
    "description": "Spawn a new process"
  },
  "System wait": {
    "prefix": "wait",
    "body": "system.wait(${1:1.0})",
    "description": "Yield process for N seconds"
  },
  "String format": {
    "prefix": "fmt",
    "body": "string.format(\"${1:%s is %d}\", ${2:args})",
    "description": "Printf-style string formatting"
  },
  "Math atan2": {
    "prefix": "atan2",
    "body": "local angle = math.atan2(${1:y}, ${2:x})",
    "description": "Compute angle from y/x"
  },
  "Audio tone": {
    "prefix": "tone",
    "body": "audio.tone(${1:freq}, ${2:0.1}, \"${3:square}\", ${4:0.2})",
    "description": "Play a tone"
  },
  "Audio load and play": {
    "prefix": "aplay",
    "body": "audio.load(\"${1:name}\", \"${2:path}\")\naudio.play(\"${1:name}\")",
    "description": "Load and play audio file"
  },
  "Main loop": {
    "prefix": "main",
    "body": "while true do\n  ${1:-- update}\n  ${2:-- render}\n  screen.sync()\nend",
    "description": "Main game loop"
  }
}