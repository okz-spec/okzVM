-- scene3d.okzlib — 3D scene library for okzVM
-- Build scenes with config tables. Serialize to .bin.
SCENE3D = {}

-- ─── Low-level primitives ──────────────────────────────────────

-- { x, y, z, u?, v? }
SCENE3D.vert = function(x, y, z, u, v)
  local vt = { x = x; y = y; z = z }
  if u ~= nil then vt.u = u end
  if v ~= nil then vt.v = v end
  return vt
end

-- { i0, i1, i2, color? }
SCENE3D.tri = function(i0, i1, i2, r, g, b, a)
  if a == nil then a = 255 end
  return { i0 = i0; i1 = i1; i2 = i2; color = { r = r; g = g; b = b; a = a } }
end

-- { i0, i1, i2, texture, texW, texH }
SCENE3D.texTri = function(i0, i1, i2, texture, texW, texH)
  return { i0 = i0; i1 = i1; i2 = i2; texture = texture; texW = texW; texH = texH }
end

-- ─── Shape builders ────────────────────────────────────────────

-- Colored box. cfg: { pos: {x, z}, y?, size: {w, h, d}, color: {r, g, b}, alpha?, rot: {rx, ry, rz}? }
SCENE3D.box = function(cfg)
  local cx = cfg.pos and cfg.pos[1] or 0
  local cz = cfg.pos and cfg.pos[2] or 0
  local cy = cfg.y or 0
  local w = cfg.size and cfg.size[1] or 1
  local h = cfg.size and cfg.size[2] or 1
  local d = cfg.size and cfg.size[3] or 1
  local col = cfg.color or { 200; 200; 200 }
  local r = col[1]; local g = col[2]; local b = col[3]
  local a = cfg.alpha or 255
  local hw = w / 2; local hh = h / 2; local hd = d / 2

  local raw = {
    { x = -hw; y = -hh; z = -hd }; { x = hw; y = -hh; z = -hd };
    { x = hw; y = hh; z = -hd }; { x = -hw; y = hh; z = -hd };
    { x = hw; y = -hh; z = hd }; { x = -hw; y = -hh; z = hd };
    { x = -hw; y = hh; z = hd }; { x = hw; y = hh; z = hd };
  }

  -- Apply rotation if specified
  local rot = cfg.rot
  if rot then
    local rx = rot[1] or 0; local ry = rot[2] or 0; local rz = rot[3] or 0
    local cxr = math.cos(rx); local sxr = math.sin(rx)
    local cy2 = math.cos(ry); local sy = math.sin(ry)
    local czr = math.cos(rz); local sz = math.sin(rz)
    for i = 1, 8 do
      local p = raw[i]
      local y1 = p.y * cxr - p.z * sxr; local z1 = p.y * sxr + p.z * cxr
      local x1 = p.x * cy2 + z1 * sy; local z2 = -p.x * sy + z1 * cy2
      local x2 = x1 * czr - y1 * sz; local y2 = x1 * sz + y1 * czr
      raw[i] = { x = x2; y = y2; z = z2 }
    end
  end

  local verts = {}
  for i = 1, 8 do
    local p = raw[i]
    verts[i] = { x = cx + p.x; y = cy + hh + p.y; z = cz + p.z }
  end

  local faces = {
    { { 1, 2, 3, 4 }, 1.0 }; { { 6, 5, 8, 7 }, 0.8 };
    { { 1, 4, 7, 6 }, 0.6 }; { { 2, 3, 8, 5 }, 0.7 };
    { { 4, 3, 8, 7 }, 0.9 }; { { 1, 2, 5, 6 }, 0.45 };
  }

  local tris = {}; local ti = 0
  for fi = 1, #faces do
    local f = faces[fi]; local s = f[2]
    local cr = math.floor(r * s); local cg = math.floor(g * s); local cb = math.floor(b * s)
    local face = f[1]
    ti = ti + 1; tris[ti] = { i0 = face[1]; i1 = face[2]; i2 = face[3]; color = { r = cr; g = cg; b = cb; a = a } }
    ti = ti + 1; tris[ti] = { i0 = face[1]; i1 = face[3]; i2 = face[4]; color = { r = cr; g = cg; b = cb; a = a } }
  end
  return { verts = verts; tris = tris }
end

-- Textured box. cfg: { pos: {x, z}, y?, size: {w, h, d}, texture, texW, texH }
SCENE3D.texBox = function(cfg)
  local cx = cfg.pos and cfg.pos[1] or 0
  local cz = cfg.pos and cfg.pos[2] or 0
  local cy = cfg.y or 0
  local w = cfg.size and cfg.size[1] or 1
  local h = cfg.size and cfg.size[2] or 1
  local d = cfg.size and cfg.size[3] or 1
  local pixels = cfg.texture; local fw = cfg.texW; local fh = cfg.texH
  local hw = w / 2; local hh = h / 2; local hd = d / 2

  local raw = {
    { x = -hw; y = -hh; z = -hd }; { x = hw; y = -hh; z = -hd };
    { x = hw; y = hh; z = -hd }; { x = -hw; y = hh; z = -hd };
    { x = hw; y = -hh; z = hd }; { x = -hw; y = -hh; z = hd };
    { x = -hw; y = hh; z = hd }; { x = hw; y = hh; z = hd };
  }
  local uvFaces = {
    { vi = { 1, 2, 3, 4 }; uv = { { 0, 1 }; { 1, 1 }; { 1, 0 }; { 0, 0 } } };
    { vi = { 6, 5, 8, 7 }; uv = { { 0, 1 }; { 1, 1 }; { 1, 0 }; { 0, 0 } } };
    { vi = { 1, 4, 7, 6 }; uv = { { 0, 1 }; { 1, 1 }; { 1, 0 }; { 0, 0 } } };
    { vi = { 2, 3, 8, 5 }; uv = { { 0, 1 }; { 1, 1 }; { 1, 0 }; { 0, 0 } } };
    { vi = { 4, 3, 8, 7 }; uv = { { 0, 1 }; { 1, 1 }; { 1, 0 }; { 0, 0 } } };
    { vi = { 1, 2, 5, 6 }; uv = { { 0, 1 }; { 1, 1 }; { 1, 0 }; { 0, 0 } } };
  }

  local verts = {}; local tris = {}; local vi = 0; local ti = 0
  for fi = 1, #uvFaces do
    local face = uvFaces[fi]
    for k = 1, 4 do
      local p = raw[face.vi[k]]; local uv = face.uv[k]
      vi = vi + 1
      verts[vi] = { x = cx + p.x; y = cy + hh + p.y; z = cz + p.z; u = uv[1]; v = uv[2] }
    end
    local i0 = vi - 4; local i1 = vi - 3; local i2 = vi - 2; local i3 = vi - 1
    ti = ti + 1; tris[ti] = { i0 = i0; i1 = i1; i2 = i2; texture = pixels; texW = fw; texH = fh }
    ti = ti + 1; tris[ti] = { i0 = i0; i1 = i2; i2 = i3; texture = pixels; texW = fw; texH = fh }
  end
  return { verts = verts; tris = tris }
end

-- Textured quad (single face). cfg: { pos: {x, y, z}, size: {w, h}, texture, texW, texH }
SCENE3D.texQuad = function(cfg)
  local x = cfg.pos and cfg.pos[1] or 0
  local y = cfg.pos and cfg.pos[2] or 0
  local z = cfg.pos and cfg.pos[3] or 0
  local w = cfg.size and cfg.size[1] or 1
  local h = cfg.size and cfg.size[2] or 1
  local hw = w / 2; local hh = h / 2
  local pixels = cfg.texture; local fw = cfg.texW; local fh = cfg.texH
  local verts = {
    SCENE3D.vert(x - hw, y - hh, z, 0, 1);
    SCENE3D.vert(x + hw, y - hh, z, 1, 1);
    SCENE3D.vert(x + hw, y + hh, z, 1, 0);
    SCENE3D.vert(x - hw, y + hh, z, 0, 0);
  }
  local tris = {
    SCENE3D.texTri(0, 1, 2, pixels, fw, fh);
    SCENE3D.texTri(0, 2, 3, pixels, fw, fh);
  }
  return { verts = verts; tris = tris }
end

-- Pillar / cylinder. cfg: { pos: {x, z}, radius, height, color: {r,g,b}, alpha?, topAlpha?, sides? }
SCENE3D.column = function(cfg)
  local cx = cfg.pos and cfg.pos[1] or 0
  local cz = cfg.pos and cfg.pos[2] or 0
  local radius = cfg.radius or 0.5
  local height = cfg.height or 2
  local col = cfg.color or { 180; 180; 180 }
  local r = col[1]; local g = col[2]; local b = col[3]
  local a = cfg.alpha or 255
  local topAlpha = cfg.topAlpha or a
  local sides = cfg.sides or 4

  local verts = {}; local tris = {}; local vi = 0; local ti = 0
  local pi2 = 6.283185

  for side = 0, sides - 1 do
    local sa1 = side * pi2 / sides; local sa2 = (side + 1) * pi2 / sides
    local sx1 = math.sin(sa1) * radius; local sz1 = math.cos(sa1) * radius
    local sx2 = math.sin(sa2) * radius; local sz2 = math.cos(sa2) * radius
    vi = vi + 1; verts[vi] = { x = cx + sx1; y = 0; z = cz + sz1 }
    vi = vi + 1; verts[vi] = { x = cx + sx2; y = 0; z = cz + sz2 }
    vi = vi + 1; verts[vi] = { x = cx + sx2; y = height; z = cz + sz2 }
    vi = vi + 1; verts[vi] = { x = cx + sx1; y = height; z = cz + sz1 }
    local i0 = vi - 4; local i1 = vi - 3; local i2 = vi - 2; local i3 = vi - 1
    ti = ti + 1; tris[ti] = { i0 = i0; i1 = i1; i2 = i2; color = { r = r; g = g; b = b; a = a } }
    ti = ti + 1; tris[ti] = { i0 = i0; i1 = i2; i2 = i3; color = { r = r; g = g; b = b; a = a } }
  end
  for side = 0, sides - 1 do
    local sa1 = side * pi2 / sides; local sa2 = (side + 1) * pi2 / sides
    local sx1 = math.sin(sa1) * radius; local sz1 = math.cos(sa1) * radius
    local sx2 = math.sin(sa2) * radius; local sz2 = math.cos(sa2) * radius
    vi = vi + 1; verts[vi] = { x = cx + sx1; y = height; z = cz + sz1 }
    vi = vi + 1; verts[vi] = { x = cx + sx2; y = height; z = cz + sz2 }
    vi = vi + 1; verts[vi] = { x = cx; y = height; z = cz }
    local i0 = vi - 3; local i1 = vi - 2; local i2 = vi - 1
    ti = ti + 1; tris[ti] = { i0 = i0; i1 = i1; i2 = i2; color = { r = r; g = g; b = b; a = topAlpha } }
  end
  return { verts = verts; tris = tris }
end

-- Billboard sprite. cfg: { pos: {x, y, z}, size: {w, h}, pixels }
SCENE3D.billboard = function(cfg)
  local x = cfg.pos and cfg.pos[1] or 0
  local y = cfg.pos and cfg.pos[2] or 0
  local z = cfg.pos and cfg.pos[3] or 0
  local w = cfg.size and cfg.size[1] or 1
  local h = cfg.size and cfg.size[2] or 1
  return { x = x; y = y; z = z; w = w; h = h; pixels = cfg.pixels }
end

-- ─── Ground / terrain ──────────────────────────────────────────

-- Checkerboard ground. cfg: { size, tileSize, colors: {{r,g,b}, ...} }
SCENE3D.ground = function(cfg)
  local size = cfg.size or 10
  local tileSize = cfg.tileSize or 2
  local colors = cfg.colors or { { 100, 100, 100 }; { 80, 80, 80 } }
  local half = size * tileSize / 2
  local nc = #colors
  local verts = {}; local tris = {}; local vi = 0; local ti = 0
  for z = 0, size - 1 do
    for x = 0, size - 1 do
      local col = colors[((x + z) % nc) + 1]
      local x0 = x * tileSize - half; local z0 = z * tileSize - half
      local x1 = x0 + tileSize; local z1 = z0 + tileSize
      vi = vi + 1; verts[vi] = { x = x0; y = 0; z = z0 }
      vi = vi + 1; verts[vi] = { x = x1; y = 0; z = z0 }
      vi = vi + 1; verts[vi] = { x = x1; y = 0; z = z1 }
      vi = vi + 1; verts[vi] = { x = x0; y = 0; z = z1 }
      local i0 = vi - 4; local i1 = vi - 3; local i2 = vi - 2; local i3 = vi - 1
      local c = { r = col[1]; g = col[2]; b = col[3] }
      ti = ti + 1; tris[ti] = { i0 = i0; i1 = i1; i2 = i2; color = c }
      ti = ti + 1; tris[ti] = { i0 = i0; i1 = i2; i2 = i3; color = c }
    end
  end
  return { verts = verts; tris = tris }
end

-- Textured ground. cfg: { size, texture, texW, texH, tileScale?, subdivs? }
SCENE3D.texturedGround = function(cfg)
  local size = cfg.size or 10
  local texture = cfg.texture; local texW = cfg.texW; local texH = cfg.texH
  local tileScale = cfg.tileScale or 2
  local subdivs = cfg.subdivs or 10
  local half = size / 2
  local cellSize = size / subdivs
  local cellUV = cellSize / tileScale
  local verts = {}; local tris = {}; local vi = 0; local ti = 0
  for gz = 0, subdivs - 1 do
    for gx = 0, subdivs - 1 do
      local x0 = gx * cellSize - half; local z0 = gz * cellSize - half
      local x1 = x0 + cellSize; local z1 = z0 + cellSize
      local u0 = gx * cellUV; local v0 = gz * cellUV
      local u1 = u0 + cellUV; local v1 = v0 + cellUV
      vi = vi + 1; verts[vi] = { x = x0; y = 0; z = z0; u = u0; v = v0 }
      vi = vi + 1; verts[vi] = { x = x1; y = 0; z = z0; u = u1; v = v0 }
      vi = vi + 1; verts[vi] = { x = x1; y = 0; z = z1; u = u1; v = v1 }
      vi = vi + 1; verts[vi] = { x = x0; y = 0; z = z1; u = u0; v = v1 }
      local i0 = vi - 4; local i1 = vi - 3; local i2 = vi - 2; local i3 = vi - 1
      ti = ti + 1; tris[ti] = { i0 = i0; i1 = i2; i2 = i1; texture = texture; texW = texW; texH = texH }
      ti = ti + 1; tris[ti] = { i0 = i0; i1 = i3; i2 = i2; texture = texture; texW = texW; texH = texH }
    end
  end
  return { verts = verts; tris = tris }
end

-- Heightmap terrain. cfg: { size, heightmap, colors?, cells?, texture?, texW?, texH?, tileScale? }
SCENE3D.terrain = function(cfg)
  local size = cfg.size or 20
  local heightmap = cfg.heightmap
  local colors = cfg.colors
  local cells = cfg.cells or 40
  local texture = cfg.texture; local texW = cfg.texW; local texH = cfg.texH
  local tileScale = cfg.tileScale or 4
  local half = size / 2
  local cellSize = size / cells
  local verts = {}; local tris = {}; local vi = 0; local ti = 0
  local rows = cells + 1
  for gz = 0, cells do
    for gx = 0, cells do
      local x = gx * cellSize - half; local z = gz * cellSize - half
      local idx = gz * rows + gx + 1
      local h = 0
      if heightmap ~= nil then h = heightmap[idx] or 0 end
      local vt = { x = x; y = h; z = z }
      if texture ~= nil then
        vt.u = (gx * cellSize / tileScale) / texW * texW
        vt.v = (gz * cellSize / tileScale) / texH * texH
      end
      if colors ~= nil then
        local c = colors[idx]
        if c ~= nil then
          if type(c) == "table" then vt.color = c
          else vt.cr = c end
        end
      end
      vi = vi + 1; verts[vi] = vt
    end
  end
  for gz = 0, cells do
    for gx = 0, cells do
      local i0 = gz * rows + gx + 1; local i1 = i0 + 1
      local i2 = (gz + 1) * rows + gx + 1; local i3 = i2 + 1
      if texture ~= nil then
        ti = ti + 1; tris[ti] = { i0 = i0; i1 = i2; i2 = i1; texture = texture; texW = texW; texH = texH }
        ti = ti + 1; tris[ti] = { i0 = i1; i1 = i2; i2 = i3; texture = texture; texW = texW; texH = texH }
      else
        local c = { r = 100; g = 160; b = 80 }
        if colors ~= nil then
          local c0 = colors[i0]
          if type(c0) == "table" then c = { r = c0[1]; g = c0[2]; b = c0[3] } end
        end
        ti = ti + 1; tris[ti] = { i0 = i0; i1 = i2; i2 = i1; color = c }
        ti = ti + 1; tris[ti] = { i0 = i1; i1 = i2; i2 = i3; color = c }
      end
    end
  end
  return { verts = verts; tris = tris }
end

-- ─── High-level builders ───────────────────────────────────────

-- Room with 4 walls, floor, and ceiling. cfg: { size: {w, h, d}, floor?, ceiling?, walls?, wallTex?, floorTex?, ceilTex? }
SCENE3D.room = function(cfg)
  local w = cfg.size and cfg.size[1] or 4
  local h = cfg.size and cfg.size[2] or 3
  local d = cfg.size and cfg.size[3] or 4
  local hw = w / 2; local hh = h / 2; local hd = d / 2
  local floorCol = cfg.floor or { 100; 80; 60 }
  local ceilCol = cfg.ceiling or { 60; 60; 70 }
  local wallCol = cfg.walls or { 140; 130; 120 }

  local objects = {}

  -- Floor
  objects[1] = SCENE3D.box({
    pos = { 0; 0 }; y = -hh; size = { w; 0.1; d }; color = floorCol
  })
  -- Ceiling
  objects[2] = SCENE3D.box({
    pos = { 0; 0 }; y = hh; size = { w; 0.1; d }; color = ceilCol
  })
  -- Front wall
  objects[3] = SCENE3D.box({
    pos = { 0; -hd }; y = 0; size = { w; h; 0.1 }; color = wallCol
  })
  -- Back wall
  objects[4] = SCENE3D.box({
    pos = { 0; hd }; y = 0; size = { w; h; 0.1 }; color = wallCol
  })
  -- Left wall
  objects[5] = SCENE3D.box({
    pos = { -hw; 0 }; y = 0; size = { 0.1; h; d }; color = wallCol
  })
  -- Right wall
  objects[6] = SCENE3D.box({
    pos = { hw; 0 }; y = 0; size = { 0.1; h; d }; color = wallCol
  })

  return SCENE3D.merge(objects)
end

-- ─── Scene operations ──────────────────────────────────────────

-- Merge multiple objects/scenes into one. Optionally apply a transform function to each vertex.
-- transform(vx, vy, vz) returns new vx, vy, vz
SCENE3D.merge = function(objects, transform)
  local sv = {}; local st = {}; local voff = 0; local vi = 1; local ti = 1
  for oi = 1, #objects do
    local o = objects[oi]
    if o ~= nil and o.verts ~= nil and o.tris ~= nil then
      local nv = #o.verts
      for i2 = 1, nv do
        local v = o.verts[i2]
        if v ~= nil then
          if transform then
            local nx, ny, nz = transform(v.x, v.y, v.z)
            sv[vi] = { x = nx; y = ny; z = nz }
            if v.u then sv[vi].u = v.u end
            if v.v then sv[vi].v = v.v end
          else
            sv[vi] = v
          end
          vi = vi + 1
        end
      end
      local nt = #o.tris
      for i2 = 1, nt do
        local t = o.tris[i2]
        if t ~= nil then
          local nt2 = { i0 = t.i0 + voff; i1 = t.i1 + voff; i2 = t.i2 + voff; color = t.color }
          if t.texture ~= nil then nt2.texture = t.texture; nt2.texW = t.texW; nt2.texH = t.texH end
          if t.texture2 ~= nil then nt2.texture2 = t.texture2; nt2.texW2 = t.texW2; nt2.texH2 = t.texH2 end
          st[ti] = nt2; ti = ti + 1
        end
      end
      voff = vi - 1
    end
  end
  return { verts = sv; tris = st }
end

-- Translate all vertices in a scene
SCENE3D.translate = function(scene, tx, ty, tz)
  return SCENE3D.merge({ scene }, function(vx, vy, vz)
    return vx + tx, vy + ty, vz + tz
  end)
end

-- Scale all vertices in a scene
SCENE3D.scale = function(scene, sx, sy, sz)
  return SCENE3D.merge({ scene }, function(vx, vy, vz)
    return vx * sx, vy * sy, vz * sz
  end)
end

-- Rotate around Y axis
SCENE3D.rotateY = function(scene, angle)
  local c = math.cos(angle); local s = math.sin(angle)
  return SCENE3D.merge({ scene }, function(vx, vy, vz)
    return vx * c + vz * s, vy, -vx * s + vz * c
  end)
end

-- Render helper. cfg: { scene, camera: {x, y, z, rx, ry, fov}, scale?, billboards?, ambient?, lightDir?, fogDensity?, fogColor? }
SCENE3D.render = function(cfg)
  local scene = cfg.scene
  local cam = cfg.camera or { x = 0; y = 3; z = 8; rx = -0.3; ry = 0; fov = 60 }
  local rcfg = {
    vertices = scene.verts;
    triangles = scene.tris;
    camera = cam;
    scale = cfg.scale or 0.5;
  }
  if cfg.billboards then rcfg.billboards = cfg.billboards end
  if cfg.ambient then rcfg.ambient = cfg.ambient end
  if cfg.lightDir then rcfg.lightDir = cfg.lightDir end
  if cfg.lightColor then rcfg.lightColor = cfg.lightColor end
  if cfg.lightIntensity then rcfg.lightIntensity = cfg.lightIntensity end
  if cfg.fogDensity then rcfg.fogDensity = cfg.fogDensity end
  if cfg.fogNear then rcfg.fogNear = cfg.fogNear end
  if cfg.fogFar then rcfg.fogFar = cfg.fogFar end
  if cfg.fogColor then rcfg.fogColor = cfg.fogColor end
  if cfg.shadows then rcfg.shadows = cfg.shadows end
  if cfg.shadowPlaneY then rcfg.shadowPlaneY = cfg.shadowPlaneY end
  if cfg.shadowAlpha then rcfg.shadowAlpha = cfg.shadowAlpha end
  if cfg.shadowColor then rcfg.shadowColor = cfg.shadowColor end
  if cfg.cullBehind then rcfg.cullBehind = cfg.cullBehind end
  screen.render3D(rcfg)
end

-- ─── Binary serialization ──────────────────────────────────────
-- Format: [MAGIC 4B][version 2B][vertCount 4B][triCount 4B]
-- Vertices: [x f32][y f32][z f32][u f32][v f32][hasUV u8]
-- Triangles: [i0 u32][i1 u32][i2 u32][hasColor u8][r u8][g u8][b u8][a u8]
--            [hasTex u8][texLen u32][texData bytes...][texW u16][texH u16]

SCENE3D.SERIALIZE_MAGIC = 0x5343454E  -- "SCEN"

SCENE3D.serialize = function(scene)
  local verts = scene.verts
  local tris = scene.tris
  local nv = #verts
  local nt = #tris

  -- Calculate total size
  local size = 16  -- header
  size = size + nv * 21  -- 5 floats + 1 byte per vertex
  for i = 1, nt do
    local t = tris[i]
    size = size + 13  -- 3 uint32 + 1 + 4 color bytes
    if t.texture ~= nil then
      local texData = t.texture
      local texLen = #texData
      size = size + 1 + 4 + texLen + 2  -- hasTex + texLen + data + texW + texH
    else
      size = size + 1  -- hasTex = 0
    end
  end

  local buf = file.readBinary and nil or nil  -- will use DataView approach
  -- Since we don't have DataView in okzVM, we'll use a compact array format
  -- Format: simple key-value pairs for editor compatibility
  local out = {}

  -- Header
  out[1] = nv  -- vertex count
  out[2] = nt  -- triangle count

  -- Vertices: flat array of [x,y,z,u,v,hasUV]
  local vi = 3
  for i = 1, nv do
    local v = verts[i]
    out[vi] = v.x; vi = vi + 1
    out[vi] = v.y; vi = vi + 1
    out[vi] = v.z; vi = vi + 1
    if v.u ~= nil then
      out[vi] = v.u; vi = vi + 1
      out[vi] = v.v; vi = vi + 1
      out[vi] = 1; vi = vi + 1  -- hasUV
    else
      out[vi] = 0; vi = vi + 1  -- u placeholder
      out[vi] = 0; vi = vi + 1  -- v placeholder
      out[vi] = 0; vi = vi + 1  -- hasUV = 0
    end
  end

  -- Triangles: flat array of [i0,i1,i2, hasColor,r,g,b,a, hasTex,texLen,...]
  for i = 1, nt do
    local t = tris[i]
    out[vi] = t.i0; vi = vi + 1
    out[vi] = t.i1; vi = vi + 1
    out[vi] = t.i2; vi = vi + 1
    if t.color ~= nil then
      out[vi] = 1; vi = vi + 1
      out[vi] = t.color.r or 255; vi = vi + 1
      out[vi] = t.color.g or 255; vi = vi + 1
      out[vi] = t.color.b or 255; vi = vi + 1
      out[vi] = t.color.a or 255; vi = vi + 1
    else
      out[vi] = 0; vi = vi + 1
      out[vi] = 0; vi = vi + 1; out[vi] = 0; vi = vi + 1; out[vi] = 0; vi = vi + 1; out[vi] = 0; vi = vi + 1
    end
    if t.texture ~= nil then
      out[vi] = 1; vi = vi + 1
      -- For now, store texture reference as nil marker (textures need external loading)
      out[vi] = 0; vi = vi + 1  -- texW
      out[vi] = 0; vi = vi + 1  -- texH
    else
      out[vi] = 0; vi = vi + 1
    end
  end

  return out
end

SCENE3D.deserialize = function(data)
  local nv = data[1]
  local nt = data[2]
  local verts = {}; local tris = {}
  local vi = 3

  for i = 1, nv do
    local x = data[vi]; local y = data[vi + 1]; local z = data[vi + 2]
    local hasUV = data[vi + 5]
    if hasUV == 1 then
      verts[i] = { x = x; y = y; z = z; u = data[vi + 3]; v = data[vi + 4] }
    else
      verts[i] = { x = x; y = y; z = z }
    end
    vi = vi + 6
  end

  for i = 1, nt do
    local t = { i0 = data[vi]; i1 = data[vi + 1]; i2 = data[vi + 2] }
    vi = vi + 3
    local hasColor = data[vi]; vi = vi + 1
    if hasColor == 1 then
      t.color = { r = data[vi]; g = data[vi + 1]; b = data[vi + 2]; a = data[vi + 3] }
      vi = vi + 4
    else
      vi = vi + 4
    end
    local hasTex = data[vi]; vi = vi + 1
    if hasTex == 1 then
      t.texW = data[vi]; t.texH = data[vi + 1]
      vi = vi + 2
    end
    tris[i] = t
  end

  return { verts = verts; tris = tris }
end